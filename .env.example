# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# App Configuration
VITE_APP_NAME=Suprise Supermarket
VITE_APP_URL=http://localhost:5173

# API Configuration (Optional - for external APIs)
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id

# Analytics (Optional)
VITE_GA_TRACKING_ID=your_google_analytics_id

# Email Service (Optional)
VITE_SENDGRID_API_KEY=your_sendgrid_api_key

# External Data APIs for Nigeria Analytics
VITE_NIGERIA_DATA_API_KEY=your_nigeria_data_api_key
VITE_MARKET_ANALYTICS_API=https://api.example.com/v1

# Platform Settings
VITE_DEFAULT_PLATFORM_FEE=2.5
VITE_DEFAULT_CURRENCY=USD
VITE_DEFAULT_TIMEZONE=Africa/Lagos
